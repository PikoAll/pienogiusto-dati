[Unit]
Description=PienoGiusto dati: re-enable pubblica.yml if GitHub disabled it for inactivity
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Adjust the path if the repo lives elsewhere on this machine.
ExecStart=%h/Scrivania/progetti/pienogiusto-dati/scripts/watchdog.sh
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
