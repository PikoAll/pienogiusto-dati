{
  "permissions": {
    "allow": [
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(gh project:*)",
      "Bash(git push origin:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard:*)",
      "Bash(rm *)",
      "Bash(git push * -f)",
      "Bash(git push *+*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push *:*)",
      "Bash(git push * --no-verify*)",
      "Bash(git push * --mirror*)",
      "Bash(git push * --prune*)",
      "Bash(gh pr merge*)",
      "Bash(gh * delete*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh issue delete*)",
      "Bash(gh project delete*)"
    ]
  }
}
